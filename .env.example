# 複製成 .env（Docker）或在 shell 裡 export。全部都有安全預設值，可留空。

# 本地不設 = 用 SQLite；Docker compose 會設成 Postgres
# DATABASE_URL=postgresql+psycopg://sea:sea@db:5432/sea

# 中央氣象署開放資料平台金鑰 https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=

# 有金鑰（或已 ant auth login）才會呼叫 LLM
ANTHROPIC_API_KEY=
USE_LLM=false
LLM_MODEL=claude-opus-5

CORS_ORIGINS=http://localhost:3000
